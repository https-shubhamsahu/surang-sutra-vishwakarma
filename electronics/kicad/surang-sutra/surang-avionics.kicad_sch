	(text "I2C ADDRESS MAP\nI2C1 (GPIO2 SDA / GPIO3 SCL), 400 kHz-1 MHz, Pi on-board fixed pull-ups:\n   0x33  MLX90640 thermal array (alone on the bus so it can run FM+)\nI2C3 (GPIO6 SDA / GPIO7 SCL, dtoverlay=i2c3-pi5), 100 kHz, R2/R3 4.7k pull-ups:\n   0x74  SEN0465 O2   (DIP A0=0 A1=0)\n   0x75  SEN0466 CO   (DIP A0=1 A1=0)\n   0x76  SEN0467 H2S  (DIP A0=0 A1=1)\n   0x77  DFRobot factory default - left unused so a fresh sensor cannot collide\nGas boards: SEL DIP = 0 (I2C), powered from 3V3 so SDA/SCL never exceed 3.3 V.\nCH4 NDIR (Ambetronics OEM) is planned on UART/RS-485 via an adapter, not on these buses." (exclude_from_sim no) (at 17.78 330.2 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "7bf27655-3290-4d3c-bf25-9b907aa35f14"))
	(rectangle (start 208.28 248.92) (end 469.9 405.13) (stroke (width 0.35) (type dash) (color 29 78 216 1)) (fill (type none)) (uuid "802420c0-a83c-4463-bb79-a93092947939"))
	(text "L. Switched loads on +5V_AUX: 850 nm illuminators, sample pump, break-beam" (exclude_from_sim no) (at 210.82 251.46 0) (effects (font (size 2.2 2.2) (bold yes)) (justify left top)) (uuid "c11120b5-e1c4-48ea-a81f-8a319ccbcc5a"))
