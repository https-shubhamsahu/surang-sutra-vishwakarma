	(text "UART0 GPIO14/15 = MAVLink (FC TELEM2)\nUART2 GPIO5 RX = LiDAR 230400 (dtoverlay=uart2-pi5)\nUART3 GPIO8/9 = scout node 921600 (uart3-pi5)\nLiDAR PWM tied to GND = internal 10 Hz scan\nIMX327: 22->15-pin FPC, 2-lane, dtoverlay=imx290\nScout XIAO 3V3 LDO feeds RFM95W (peak ~0.47 A)" (exclude_from_sim no) (at 383.54 205.74 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "3b887930-4c8e-4f85-a6fc-69d77e105834"))
