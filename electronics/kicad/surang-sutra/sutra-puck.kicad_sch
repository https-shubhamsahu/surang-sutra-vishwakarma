	(wire (pts (xy 266.7 160.02) (xy 266.7 157.48)) (stroke (width 0) (type default)) (uuid "4fbf7883-41a9-4aab-b354-1c42d23fcc6b"))
	(label "U0TXD" (at 266.7 157.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3da27bf2-816d-4200-a325-397308872b6e"))
	(text "Strapping: IO2 and IO8 held high (10k), IO9 = BOOT (10k up, SW2 to GND)\n-> SPI boot normally, download mode with SW2.  No other load on IO2/8/9.\nEN: 10k + 1 uF RC delay after 3V3 rises; SW1 = reset.\nIO18/IO19 = native USB-Serial/JTAG: flash + console over the same USB-C.\nLoRa SPI through the GPIO matrix (SX1276 max 10 MHz SCK).\nDIO0/DIO1 on IO1/IO3 (deep-sleep wake capable, GPIO0-5).\nBattery ADC on IO0 = ADC1_CH0 (C3 ADC2 is uncalibrated, erratum: avoid).\nIO20 drives the status LED; IO21 (U0TXD) = boot-log test pad." (exclude_from_sim no) (at 165.1 185.42 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "b10c78e6-f75a-41db-8c22-fb7ba320a600"))
	(rectangle (start 289.56 22.86) (end 404.14 129.54) (stroke (width 0.35) (type dash) (color 22 163 74 1)) (fill (type none)) (uuid "cb20a2cb-d197-4ae8-9f76-91e8eb77a64f"))
	(text "D. LoRa lifeline - RFM95W-868 (SX1276), 865-867 MHz" (exclude_from_sim no) (at 292.1 25.4 0) (effects (font (size 2 2) (bold yes)) (justify left top)) (uuid "6511e961-e679-484e-8e48-dee29bcab1b1"))
